# Django Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite in the project directory)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Email Settings (optional)
# Leave EMAIL_HOST_USER / EMAIL_HOST_PASSWORD blank to disable email delivery.
# Contact messages are always saved to the database and visible in the admin.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
